<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>

  <material name="black1">
    <color rgba="0.01 0.01 0.01 1"/>
  </material>

  <material name="black2">
    <color rgba="0.045 0.045 0.045 1"/>
  </material>

  <material name="black3">
    <color rgba="0.075 0.075 0.075 1"/>
  </material>

  <material name="black4">
    <color rgba="0.11 0.11 0.11 1"/>
  </material>

  <material name="blue">
    <color rgba="0 0 0.8 0.7"/>
  </material>

  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

</robot>
